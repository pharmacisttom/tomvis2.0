PORT=3000
TOMVIS_MODE=sandbox
# Set a private demo password before starting. No default credentials.
TOMVIS_DEMO_PASSWORD=
TOMVIS_MULTI_TENANT=false
TOMVIS_API_PORT=8000
TOMVIS_PUBLIC_ORIGIN=http://localhost:3000
# Optional installed interpreter; .venv is selected automatically by the launcher.
TOMVIS_PYTHON=
