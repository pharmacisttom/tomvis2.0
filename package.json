{
  "name": "tomvis-framework",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node scripts/dev-hybrid.js",
    "start": "node scripts/dev-hybrid.js --production-build",
    "test": "node --test tests/*.test.js",
    "doctor": "node scripts/doctor.js",
    "build": "npm run build --workspace @tomvis/web",
    "deploy:check": "node scripts/doctor.js --deploy",
    "docs:generate": "node scripts/generate-manual.js",
    "prebuild": "npm run docs:generate",
    "dev:legacy": "node apps/server.js",
    "test:python": "node scripts/python-test.js",
    "predev": "npm run docs:generate",
    "test:hybrid": "node scripts/python-test.js --hybrid",
    "test:browser": "node scripts/python-test.js --hybrid --browser"
  },
  "workspaces": [
    "apps/web"
  ],
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
